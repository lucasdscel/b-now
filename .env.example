# URL pública del proyecto Supabase (visible en el cliente)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key pública — solo tiene acceso a lo que permiten las RLS policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key — bypasea RLS, solo para scripts server-side o Edge Functions.
# JAMÁS exponer al cliente ni incluir en variables NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# URL pública del sitio. Usada en el emailRedirectTo del magic link.
# Ej: https://beautynow.cl en producción, http://localhost:3000 en local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
